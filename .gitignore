# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
# Anchored to the repository root. A bare `build/` also matches
# src/nullius/build/, which silently excluded that package from git and
# from the wheel until CI could not import it.
/build/
/dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Nullius runtime state — provenance lives in the ledger, not in git
objects/            # content-addressed artifact store
runs/               # experiment working directories
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.nullius/

# Datasets are vendored deliberately and by hash; nothing lands here by accident
data/**
!data/.gitkeep
!data/**/*.manifest.json

# Secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
